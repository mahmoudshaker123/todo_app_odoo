<odoo>

    <record id="todo_task_view_tree" model="ir.ui.view">
        <field name="name">todo task tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="due_date"/>
                <field name="assign_to_id"/>
                <field name="state"
                       widget="badge"
                       decoration-primary="state == 'new'"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'closed'"/>

            </tree>
        </field>
    </record>
    <record id="todo_task_view_form" model="ir.ui.view">
        <field name="name">todo task form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                        <button name="actions_in_progress" type="object" class="btn-primary" string="In Progress"
                                invisible="state in ('in_progress','closed','completed')"/>

                        <button name="actions_completed" type="object" class="btn-primary" string="Set Completed"
                                invisible="state in ('completed','closed')"/>

                        <button name="actions_closed" type="object" class="btn-primary" string="Closed"
                                invisible="state=='closed'"/>

                        <field name="state" widget="statusbar"/>

                    </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>
                    <group>
                        <group>
                            <field name="due_date"/>
                            <field name="estimated_time"/>
                        </group>
                        <group>
                            <field name="assign_to_id"/>
                        </group>
                    </group>
                        <group>
                              <field name="description" required="1"/>
                        </group>

                    <notebook>
                            <page string="Time Sheet">
                                <field name="timesheet_ids" readonly="state == 'closed'">
                                    <tree editable="bottom">
                                         <field name="description"/>
                                         <field name="time_spent"/>
                                    </tree>
                                </field>

                            </page>
                </notebook>
                </sheet>




                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>

                </div>
            </form>
        </field>
    </record>

     <record id="todo_task_view_search" model="ir.ui.view">
        <field name="name">todo task search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assign_to_id"/>

                <filter name="state_new" string="New" domain="[('state','=','new')]" />
                <filter name="state_in_progress" string="In Progress" domain="[('state','=','in_progress')]" />
                <filter name="state_completed" string="Completed" domain="[('state','=','completed')]" />

                <filter name="group_state" string="Status" context="{'group_by':'state'}" />
                <filter name="group_date" string="Date" context="{'group_by':'due_date'}" />
                <filter name="group_assign" string="Assign To" context="{'group_by':'assign_to_id'}" />
            </search>
        </field>
    </record>

    <record id="todo_task_action" model="ir.actions.act_window">
        <field name="name">ToDo Task</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_close_tasks" model="ir.actions.server">
        <field name="name">Close Selected Tasks</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.actions_closed()</field>
    </record>


    <menuitem
        id="all_task_menu_item"
        name="All Tasks"
        parent="todo_menu"
        action="todo_task_action"
    />

</odoo>
