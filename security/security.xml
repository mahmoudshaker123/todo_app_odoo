<odoo>
    <!-- New Category -->
    <record id="module_category_todo_groups" model="ir.module.category">
        <field name="name">Todo Groups</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groups -->
    <record id="group_todo_task_manager" model="res.groups">
        <field name="name">Managers</field>
        <field name="category_id" ref="todo_app.module_category_todo_groups"/>
    </record>

    <record id="group_todo_task_user" model="res.groups">
        <field name="name">Users</field>
        <field name="category_id" ref="todo_app.module_category_todo_groups"/>
    </record>

    <!-- Record Rule: Users can only see tasks assigned to them OR created by them -->
    <record id="todo_task_user_rule" model="ir.rule">
        <field name="name">Users can see own/assigned tasks</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="groups" eval="[(4, ref('todo_app.group_todo_task_user'))]"/>
        <field name="domain_force">['|', ('assign_to_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

</odoo>
